{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/day35/tournament.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "template_id",
    "schedule_id",
    "starts_at",
    "registration_opens_at",
    "registration_closes_at",
    "status",
    "template_snapshot",
    "schedule_snapshot"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "schedule_id": {"type": "string", "minLength": 1},
    "starts_at": {"type": "string", "format": "date-time"},
    "registration_opens_at": {"type": "string", "format": "date-time"},
    "registration_closes_at": {"type": "string", "format": "date-time"},
    "status": {"const": "scheduled"},
    "template_snapshot": {"$ref": "#/$defs/template"},
    "schedule_snapshot": {"$ref": "#/$defs/schedule"}
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "max_players", "entry", "rounds", "rewards", "tie_policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "max_players": {"type": "integer", "minimum": 1},
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ticket_id"],
          "properties": {
            "type": {"enum": ["free", "ticket"]},
            "ticket_id": {"type": "string"}
          }
        },
        "rounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "name", "description", "duration_minutes", "rules"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "duration_minutes": {"type": "integer", "minimum": 1},
              "rules": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attempt_limit", "score_aggregation"],
                "properties": {
                  "attempt_limit": {"type": "integer", "minimum": 1},
                  "score_aggregation": {"enum": ["best", "sum"]}
                }
              }
            }
          }
        },
        "rewards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["place", "type", "amount"],
            "properties": {
              "place": {"type": "integer", "minimum": 1},
              "type": {"const": "points"},
              "amount": {"type": "integer", "minimum": 0}
            }
          }
        },
        "tie_policy": {"const": "shared_place_full_reward"}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "template_id", "dtstart", "timezone", "rrule", "registration_open_offset_seconds", "registration_close_offset_seconds", "enabled"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "template_id": {"type": "string", "minLength": 1},
        "dtstart": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "rrule": {"type": "string", "minLength": 1},
        "registration_open_offset_seconds": {"type": "integer"},
        "registration_close_offset_seconds": {"type": "integer"},
        "enabled": {"type": "boolean"}
      }
    }
  }
}
