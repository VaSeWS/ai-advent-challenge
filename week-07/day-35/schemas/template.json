{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/day35/template.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "max_players", "entry", "rounds", "rewards", "tie_policy"],
